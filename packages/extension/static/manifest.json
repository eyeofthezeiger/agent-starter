{
  "manifest_version": 3,
  "name": "Chief of Staff",
  "version": "0.1.0",
  "description": "Side panel for your local chief-of-staff queue and briefs, plus right-click Send to queue.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "contextMenus", "storage"],
  "host_permissions": ["http://localhost:8787/*", "http://127.0.0.1:8787/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Open the queue"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://localhost:8787 http://127.0.0.1:8787"
  }
}
