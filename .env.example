# Copy to .env (`make setup` does it) and fill in. .env is git-ignored.
# Local dev only. Synthetic data only. Real team setups inject secrets from a
# secrets manager instead of an env file (see SECURITY.md).

# --- Postgres (local container) ---
POSTGRES_USER=cos
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=cos

# --- Core service ---
CORE_PORT=8787
# Shared secret the Slack app and the Chrome extension send as a Bearer token.
# Generate one: openssl rand -hex 32
CORE_API_TOKEN=change-me
# Who the agent works for, approvers, the Slack command, source trust, approval
# tiers and skill packs live in agent.config.json, not here. This file is only
# for secrets and runtime switches.
# true = outgoing writes (Slack posts, Jira issues, bus events) are logged, not sent.
DRY_RUN=true
# true = start with the pause switch on. Intake and logging continue; actions stop.
START_PAUSED=false
TZ=America/New_York
MORNING_DIGEST_AT=08:00
SWEEP_INTERVAL_MINUTES=60
# Security baseline: inbox records and logs kept 90 days, then deleted.
RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=90

# --- Triage (stubbed) ---
# fake = deterministic keyword rules, no model calls. claude = not implemented yet.
TRIAGE_IMPL=fake
TRIAGE_CONFIDENCE_THRESHOLD=0.7
# An organization-owned key, never a personal one. Unused while TRIAGE_IMPL=fake.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_TRIAGE=claude-haiku-5-5

# --- Slack app (Socket Mode, no public URL) ---
# xoxb-... from OAuth & Permissions
SLACK_BOT_TOKEN=
# xapp-... from Basic Information > App-Level Tokens (scope: connections:write)
SLACK_APP_TOKEN=
GATE_SYNC_MINUTES=15

# --- Jira / Confluence (service user, one project) ---
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=COS
JIRA_ISSUE_TYPE=Task
CONFLUENCE_BASE_URL=https://your-company.atlassian.net/wiki

# --- Messenger bus ---
# none | log | mcp (mcp = your messenger MCP adapter, see docs/mcp-adapter.md)
MESSENGER_BUS=log

# --- Worker (compose profile "worker", off by default) ---
# false = the worker prints the command it would run and exits.
WORKER_ENABLED=false
# Agent GitHub account token: push to agent/* branches and open PRs only.
AGENT_GITHUB_TOKEN=
# Clone URL of the one repo this worker may touch.
WORKER_REPO_URL=
